#!/bin/sh
# Builds and runs the software-design binary for this plugin version.
#
#   scripts/software-design install   build this plugin's source into ~/.software-design
#   scripts/software-design <args>    run that build
#
# The global installer builds before the user starts a session. Agent plugin
# directories share a binary when their release versions match.
# SOFTWARE_DESIGN_BIN overrides it; a source checkout can use target/release.
# Hooks tolerate a missing binary and session-start explains how to install it.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
home="${SOFTWARE_DESIGN_HOME:-$HOME/.software-design}"
bin="$home/bin/software-design"
lock="$home/build.lock"
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$root/crates/software-design/Cargo.toml" | head -n 1)
# The version on main, fetched at most daily by `install`; session-start tells the
# user when it is newer. Best effort: offline, nothing is said.
latest="$home/latest"

# A build holds the lock while its process, recorded in the lock, is alive. A lock
# without a pid is a build that is just starting, or one from before pids; it
# counts for an hour.
building() {
  [ -d "$lock" ] || return 1
  if [ -f "$lock/pid" ]; then
    kill -0 "$(cat "$lock/pid")" 2>/dev/null
  else
    [ -z "$(find "$lock" -maxdepth 0 -mmin +60 2>/dev/null)" ]
  fi
}

current() {
  [ -x "$bin" ] &&
    [ "$("$bin" --version 2>/dev/null)" = "software-design $version" ]
}

fetch_latest() {
  [ -n "$(find "$latest" -mmin -1440 2>/dev/null)" ] && return 0
  mkdir -p "$home"
  curl -fsS --max-time 5 https://raw.githubusercontent.com/iaserrat/software-design/main/crates/software-design/Cargo.toml 2>/dev/null |
    sed -n 's/^version = "\(.*\)"$/\1/p' | head -n 1 >"$latest.tmp" &&
    [ -s "$latest.tmp" ] && mv "$latest.tmp" "$latest"
  rm -f "$latest.tmp"
}

# Prints a session-start message when main has a newer version than this plugin.
update_notice() {
  new=$(cat "$latest" 2>/dev/null) || return 0
  [ -n "$new" ] && [ "$new" != "$version" ] || return 0
  [ "$(printf '%s\n%s\n' "$version" "$new" | sort -V | tail -n 1)" = "$new" ] || return 0
  printf '{"systemMessage":"software-design: %s is out (you have %s). Rerun the global installer to update and build it"}\n' "$new" "$version"
}

install() {
  fetch_latest || true
  if current; then
    return 0
  fi
  if ! command -v cargo >/dev/null 2>&1; then
    echo "software-design: building needs Rust. Install it from https://rustup.rs, then run: $0 install" >&2
    return 1
  fi
  mkdir -p "$home"
  # One build at a time; a lock left by a killed build is removed.
  if ! building; then
    rm -rf "$lock"
  fi
  if ! mkdir "$lock" 2>/dev/null; then
    echo "software-design: another build is running; see $home/build.log" >&2
    return 1
  fi
  trap 'rm -rf "$lock"' EXIT INT TERM
  echo "$$" >"$lock/pid"
  echo "software-design: building $version into $home; log in $home/build.log" >&2
  if ! (cd "$root" && cargo install --locked --force --path crates/software-design --root "$home") >"$home/build.log" 2>&1; then
    echo "software-design: the build failed; see $home/build.log" >&2
    return 1
  fi
  echo "software-design: installed $bin" >&2
}

if [ "${1-}" = install ]; then
  install
  exit
fi

if [ -n "${SOFTWARE_DESIGN_BIN-}" ]; then
  exec "$SOFTWARE_DESIGN_BIN" "$@"
fi
if [ -x "$root/target/release/software-design" ]; then
  exec "$root/target/release/software-design" "$@"
fi
if current; then
  # The binary's session-start prints nothing, so this is the hook's only output.
  if [ "${1-}" = hook ] && [ "${2-}" = session-start ]; then
    update_notice
  fi
  exec "$bin" "$@"
fi

if [ "${1-}" = hook ]; then
  if [ "${2-}" = session-start ]; then
    why="version $version is not built. Run the installer from https://github.com/iaserrat/software-design, then start a new session"
    printf '{"systemMessage":"software-design: %s"}\n' "$why"
  fi
  exit 0
fi
echo "software-design: version $version is not built. Run: $0 install" >&2
exit 1
